# Optional. Without these variables /admin stays disabled.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
# Restrict the fine-grained token to YOUR copy, Contents: read/write.
# Never prefix these variables with NEXT_PUBLIC_.
INVITATION_GITHUB_TOKEN=
INVITATION_GITHUB_REPOSITORY=YOUR_USERNAME/YOUR_REPOSITORY
INVITATION_GITHUB_BRANCH=main
